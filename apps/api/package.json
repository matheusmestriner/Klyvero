{
  "name": "@klyvero/api",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest --passWithNoTests",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push --skip-generate",
    "db:push": "prisma db push --skip-generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:migration:create": "prisma migrate dev --name baseline",
    "test:e2e": "jest --config ./jest-e2e.config.js --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.14.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@nestjs/throttler": "6.4.0",
    "bullmq": "5.58.5",
    "ioredis": "5.7.0",
    "nodemailer": "7.0.6",
    "googleapis": "159.0.0",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@types/cookie-parser": "1.4.9",
    "@types/node": "24.3.0",
    "prisma": "6.14.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "@types/express": "5.0.3",
    "@types/nodemailer": "7.0.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "@types/jest": "29.5.14",
    "@types/mailparser": "3.9.0",
    "@types/smtp-server": "3.5.13",
    "mailparser": "3.12.4",
    "smtp-server": "3.21.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
